{
  "name": "open-anesthesia-4d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "review:docs": "esbuild scripts/build-review-docs.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/review-docs.mjs --log-level=warning && node node_modules/.cache/review-docs.mjs",
    "sanity": "esbuild scripts/sanity/run.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/sanity.mjs --log-level=warning && node node_modules/.cache/sanity.mjs",
    "anatomy:build": "esbuild scripts/anatomy/build-anatomy.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/build-anatomy.mjs --log-level=warning && node node_modules/.cache/build-anatomy.mjs",
    "anatomy:airway": "esbuild scripts/anatomy/build-airway-map.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/build-airway-map.mjs --log-level=warning && node node_modules/.cache/build-airway-map.mjs",
    "adversarial": "esbuild scripts/adversarial/run.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/adversarial.mjs --log-level=warning && node node_modules/.cache/adversarial.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
